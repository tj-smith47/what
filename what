#!/usr/bin/env bash
# One-line answers to quick technical questions, via Claude Code.
set -euo pipefail

model=${WHAT_MODEL:-claude-sonnet-5}
effort=${WHAT_EFFORT:-auto}
tools=${WHAT_TOOLS:-Read,Glob,Grep}

while [[ $# -gt 0 ]]; do
  case $1 in
    -m|--model)  model=$2; shift 2 ;;
    -e|--effort) effort=$2; shift 2 ;;
    -t|--tools)  tools=$2; shift 2 ;;
    --add-alias)
      src=$(readlink -f "$0"); bin=$(cd "$(dirname "$0")" && pwd)
      for name in $(printf '%s' "$2" | tr ',' ' '); do
        [[ $name != */* ]] || { echo "what: bad alias name '$name'" >&2; exit 2; }
        # who, which and where are real commands; shadowing them breaks scripts.
        existing=$(command -v "$name" 2>/dev/null || true)
        if [[ -n $existing && $(readlink -f "$existing" 2>/dev/null) != "$src" && -z ${force:-} ]]; then
          echo "what: '$name' is already $existing, skipping (--force to shadow it)" >&2
          continue
        fi
        ln -sfn "$src" "$bin/$name" && echo "aliased: $bin/$name -> $src"
      done
      exit 0 ;;
    --list-tools)
      # No CLI lists them, but a session announces its own set in its init event.
      claude -p --safe-mode --tools default --output-format stream-json --verbose \
        --model "$model" -- hi </dev/null | head -1 |
        python3 -c 'import json,sys; print("\n".join(sorted(json.load(sys.stdin)["tools"] + ["Glob", "Grep"])))'
      exit 0 ;;
    -h|--help)
      cat <<'USAGE'
what: ask a quick technical question, get one line back.

  what is the sort flag for selecting the field to sort by
  what does chmod 4755 mean
  echo "$err" | what does this mean

  --add-alias how,where   install `how` and `where` alongside this command, so
                          `how do i ...` and `where does ... live` work too. Names
                          that already exist as commands are skipped unless -f.

  -m, --model   model (env WHAT_MODEL, default claude-sonnet-5)
  -e, --effort  auto|low|medium|high|xhigh|max (env WHAT_EFFORT, default auto)
  -t, --tools   tools it may use (env WHAT_TOOLS, default Read,Glob,Grep, it
                can look at your files but not change them or reach the
                network). Comma- or space-separated built-in tool names;
                "none" for none, "default" for the whole built-in set.
                Worth adding: Bash, WebSearch, WebFetch.
      --list-tools   print the tool names this claude build accepts
USAGE
      exit 0 ;;
    -f|--force)  force=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

case $effort in
  auto|"") effort="" ;;                 # claude has no "auto" level; omitting the flag IS auto
  low|medium|high|xhigh|max) ;;
  *) echo "what: bad effort '$effort' (auto|low|medium|high|xhigh|max)" >&2; exit 2 ;;
esac

[[ $tools != none ]] || tools=""

q="$*"
# Only a pipe or a file redirect is question context; an inherited stdin (cron,
# an agent harness, /dev/null) must not make `cat` block forever.
stdin=""
if [[ ! -t 0 && ( -p /dev/stdin || -f /dev/stdin ) ]]; then stdin=$(cat); fi

if [[ -z ${q//[[:space:]]/} ]]; then
  [[ -n ${stdin//[[:space:]]/} ]] || { echo "what: no question given (try: what --help)" >&2; exit 2; }
  q="is this? explain concisely"
fi

# The command name is the first word of the sentence: `what is X` -> "what is X",
# and an alias speaks for itself: `how do I X` -> "how do I X".
words='what|how|why|when|where|who|which|whose|whom'
self=${0##*/}
[[ $self =~ ^($words)$ ]] || self=what
[[ $q =~ ^[[:space:]]*($words)([[:space:]]|$) ]] || q="$self $q"

[[ -z $stdin ]] || q=$(printf '%s\n\nContext (piped to stdin):\n%s' "$q" "$stdin")

exec claude -p \
  --safe-mode \
  --no-session-persistence \
  --tools "$tools" \
  --permission-prompts none \
  --model "$model" \
  ${effort:+--effort "$effort"} \
  --system-prompt 'You answer quick technical questions asked from a terminal. Rules: answer in ONE line; three at most, and only when the question genuinely needs them. Plain text only, no markdown, no bullets, no backticks, no code fences, no preamble, no restating the question, no closing caveats or offers of help. Never ask a clarifying question: pick the most likely reading (assume the standard Unix/POSIX tool unless another is named) and answer it. If the answer is a flag or command, show the literal invocation. Never emit tool-call syntax or XML function blocks: answer from your own knowledge unless you actually have a tool available. If the question is about files in the current directory, look before answering; otherwise do not touch the filesystem.' \
  -- "$q" </dev/null
